# Questions 2c and 3: as root, write the selection of check_root for this keyboard into
# /data/system/input-manager-state.xml while the system is stopped (a copy of the entry case 06 stored, with
# this keyboard and layout), start it again, then type.
kind=uinput
device=yakbd-check-root
vid=0x1209
pid=0xa003
select=root
layout=org.yakbd.androidcheck/org.yakbd.androidcheck.CodeLayouts/check_root
keys=Q RALT+W E A
expect=æøá
from_device=yakbd-check-api
from_pid=0xa002
from_layout=org.yakbd.androidcheck/org.yakbd.androidcheck.CodeLayouts/check_api
