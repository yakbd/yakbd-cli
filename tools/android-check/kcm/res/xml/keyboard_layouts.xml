<?xml version="1.0" encoding="utf-8"?>
<!-- check_auto carries the language of the check IME's only subtype (eo), so the system may pick it
     by itself; check_api and check_root carry no language and are never picked automatically. -->
<keyboard-layouts xmlns:android="http://schemas.android.com/apk/res/android">
    <keyboard-layout android:name="check_auto" android:label="yakbd check auto"
        android:keyboardLayout="@raw/check_auto" android:keyboardLocale="eo" />
    <keyboard-layout android:name="check_api" android:label="yakbd check api"
        android:keyboardLayout="@raw/check_api" />
    <keyboard-layout android:name="check_root" android:label="yakbd check root"
        android:keyboardLayout="@raw/check_root" />
</keyboard-layouts>
