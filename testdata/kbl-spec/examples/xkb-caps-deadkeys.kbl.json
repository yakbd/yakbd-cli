    },
    "KeyT": {
      "scanCode": "14"
    },
    "KeyD": {
      "scanCode": "20"
    },
    "Quote": {
      "scanCode": "28"
    },
    "Space": {
      "scanCode": "39"
    },
    "AltRight": {
      "scanCode": "E038"
    }
  },
