{
  "$schema": "https://yakbd.github.io/kbl-spec/schema/0.2/kbl.schema.json",
  "kbl": "0.2",
  "metadata": {
    "id": "fo-t-k0-xkbdemo",
    "name": "XKB demo (example)",
    "version": "0.2.0",
    "license": "MIT-0",
    "description": "Example (g), a 0.2 file for the Linux XKB target: Caps Lock that capitalises the letters of levels 1 and 2 but leaves the AltGr level of KeyT alone (no stock key type can, so the file asks for yakbd key types), a dead key with a sequence for itself, and a few targets.xkb pins; everything else comes from the default rules of the XKB target.",
    "authors": [
      {
        "name": "The YAKBD contributors"
      }
    ]
  },
