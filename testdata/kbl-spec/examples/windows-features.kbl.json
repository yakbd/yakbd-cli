  "metadata": {
    "id": "fo-t-k0-kblwin",
    "locales": [
      "fo",
      "ja"
    ],
    "name": "Windows feature tour (example)",
    "localizedNames": {
      "fo": "Windows-eginleikar (dømi)"
    },
    "description": "Example (d): a synthetic layout that uses every Windows-only feature the format holds: Shift Lock, LRM/RLM on Shift+Backspace, an extra AltGr-like modifier on right Ctrl (VK OEM_8), a Kana modifier and Kana lock (KANALOK), CAPLOK, SGCAPS, CAPLOKALTGR and GRPSELTAP, an Alt-only column, a Ctrl column, E0 and E1 scan codes, a Num Lock key, key names and dead-key names, a ligature, chained dead keys, CodeUnits outputs (a lone surrogate, a marker value), extra rows, a fully pinned targets.windows (modifier bits, ModNumber, tables, flags, keyboard type, version word, strings in two languages, version resource, registration), and NLS and dispatcher data that are carried but not compiled. Not a usable layout.",
    "authors": [
      {
        "name": "The YAKBD contributors",
        "url": "https://github.com/yakbd"
      }
    ],
    "attribution": "YAKBD",
    "layoutPattern": "QWERTY",
    "indicator": "FO",
    "version": "1.2.3",
    "license": "MIT-0",
    "copyright": "Copyright 2026 The YAKBD contributors",
    "organization": "The YAKBD contributors",
    "draft": "unconfirmed"
  },
